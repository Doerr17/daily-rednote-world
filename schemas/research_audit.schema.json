{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent semantic research audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["audit_version", "claim_reviews", "coordinate_review", "overall_notes"],
  "properties": {
    "audit_version": {"type": "string", "const": "1.0"},
    "claim_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "status", "reason", "verified_source_ids"],
        "properties": {
          "claim_id": {"type": "string"},
          "status": {"type": "string", "enum": ["supported", "unsupported", "conflicted", "needs_review"]},
          "reason": {"type": "string"},
          "verified_source_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "coordinate_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"type": "string", "enum": ["supported", "conflicted", "needs_review"]},
        "reason": {"type": "string"}
      }
    },
    "overall_notes": {"type": "array", "items": {"type": "string"}}
  }
}
