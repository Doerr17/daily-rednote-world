{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research_package.schema.json",
  "title": "Daily world research package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "research_date", "topic_id", "fixture_mode", "location",
    "sources", "claims", "interesting_fact_claim_ids", "uniqueness_claim_ids",
    "travel_claim_ids", "unknowns", "further_questions"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "research_date": {"type": "string", "format": "date"},
    "topic_id": {"type": "string", "minLength": 1},
    "fixture_mode": {"type": "boolean"},
    "location": {"$ref": "location.schema.json"},
    "sources": {"type": "array", "minItems": 2, "items": {"$ref": "source.schema.json"}},
    "claims": {"type": "array", "minItems": 3, "items": {"$ref": "claim.schema.json"}},
    "interesting_fact_claim_ids": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}},
    "uniqueness_claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "travel_claim_ids": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "further_questions": {"type": "array", "items": {"type": "string"}}
  }
}
