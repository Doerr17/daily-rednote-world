{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "location.schema.json",
  "title": "Verified location",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name_zh", "name_en", "country_zh", "country_en", "region", "continent",
    "location_type", "latitude", "longitude", "coordinate_status", "coordinate_evidence"
  ],
  "properties": {
    "name_zh": {"type": "string", "minLength": 1},
    "name_en": {"type": "string", "minLength": 1},
    "country_zh": {"type": "string", "minLength": 1},
    "country_en": {"type": "string", "minLength": 1},
    "region": {"type": "string", "minLength": 1},
    "continent": {"type": "string", "minLength": 1},
    "location_type": {"type": "string", "minLength": 1},
    "latitude": {"type": "number", "minimum": -90, "maximum": 90},
    "longitude": {"type": "number", "minimum": -180, "maximum": 180},
    "coordinate_status": {"type": "string", "enum": ["verified", "conflict", "pending"]},
    "coordinate_evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "latitude", "longitude", "locator", "evidence_quote"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "latitude": {"type": "number", "minimum": -90, "maximum": 90},
          "longitude": {"type": "number", "minimum": -180, "maximum": 180},
          "locator": {"type": "string", "minLength": 1},
          "evidence_quote": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
