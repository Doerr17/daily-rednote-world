{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source.schema.json",
  "title": "Fetched research source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id", "url", "final_url", "title", "publisher", "source_type",
    "reliability_tier", "language", "accessed_at", "published_at", "applicable_at",
    "content_sha256", "cache_path", "limitations", "fetch_status"
  ],
  "properties": {
    "source_id": {"type": "string", "pattern": "^s[0-9]{2,}$"},
    "url": {"type": "string", "minLength": 1},
    "final_url": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "source_type": {"type": "string", "enum": ["government", "unesco", "museum", "academic", "transport", "tourism_official", "reference", "fixture"]},
    "reliability_tier": {"type": "string", "enum": ["primary", "authoritative", "secondary", "discovery_only"]},
    "language": {"type": "string", "minLength": 2},
    "accessed_at": {"type": "string", "minLength": 10},
    "published_at": {"type": ["string", "null"]},
    "applicable_at": {"type": ["string", "null"]},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "cache_path": {"type": "string", "minLength": 1},
    "limitations": {"type": "string"},
    "fetch_status": {"type": "string", "enum": ["fetched", "cached", "fixture"]}
  }
}

