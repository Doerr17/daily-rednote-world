{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved media manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "topic_id", "fixture_mode", "assets"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "topic_id": {"type": "string"},
    "fixture_mode": {"type": "boolean"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id", "local_path", "source_page", "file_url", "creator",
          "license", "license_url", "credit", "attribution_required",
          "accessed_at", "location_match_status", "location_match_evidence",
          "sha256", "width", "height", "crop_policy"
        ],
        "properties": {
          "asset_id": {"type": "string"},
          "local_path": {"type": "string"},
          "source_page": {"type": "string"},
          "file_url": {"type": "string"},
          "creator": {"type": "string"},
          "license": {"type": "string"},
          "license_url": {"type": "string"},
          "credit": {"type": "string"},
          "attribution_required": {"type": "boolean"},
          "accessed_at": {"type": "string"},
          "location_match_status": {"type": "string", "const": "verified"},
          "location_match_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "sha256": {"type": "string"},
          "width": {"type": "integer"},
          "height": {"type": "integer"},
          "crop_policy": {"type": "string"}
        }
      }
    }
  }
}
